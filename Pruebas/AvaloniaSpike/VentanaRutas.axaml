<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaSpike.VentanaRutas"
        Title="Indicá las rutas de RimWorld y del workshop"
        Width="700" Height="200"
        MinWidth="480" MinHeight="180"
        SizeToContent="Height">

  <!--
    El equivalente de FormInitialPathSelect.

    Las tres columnas son todo el truco: la primera se ancha sola hasta el rotulo mas
    largo y los alinea; la del medio se queda con el resto y estira los campos; la
    tercera vuelve a ajustarse al boton. Eso es lo que en WinForms hace AutoAjuste
    midiendo textos y corriendo controles en tiempo de ejecucion.
  -->
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="rotuloRimworld"
               VerticalAlignment="Center" Margin="0,0,12,0" />
    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="rutaRimworld" />
    <Button    Grid.Row="0" Grid.Column="2" Content="..." Width="48" Margin="8,0,0,0" />

    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="rotuloWorkshop"
               VerticalAlignment="Center" Margin="0,12,12,0" />
    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="rutaWorkshop" Margin="0,12,0,0" />
    <Button    Grid.Row="1" Grid.Column="2" Content="..." Width="48" Margin="8,12,0,0" />

    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="botonListo"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Margin="0,16,0,0" />
  </Grid>
</Window>
