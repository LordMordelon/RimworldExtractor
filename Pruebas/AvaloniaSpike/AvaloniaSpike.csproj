<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prueba de concepto: el mismo formulario que FormInitialPathSelect, hecho en Avalonia,
    para decidir con evidencia si conviene cambiar de framework.

    A proposito NO esta en RimworldExtractor.sln: asi ni la compilacion de la solucion ni
    la CI se enteran, y si la prueba se descarta se borra la carpeta y no queda rastro.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>

  <!-- Se usa el Strings.cs de verdad, no una copia: ademas de hacer honesta la
       comparacion, comprueba que la capa de textos sobrevive al cambio de framework. -->
  <ItemGroup>
    <ProjectReference Include="..\..\RimworldExtractorInternal\RimworldExtractorInternal.csproj" />
  </ItemGroup>

</Project>
